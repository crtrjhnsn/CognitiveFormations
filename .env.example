# Copy to .env.local and fill in. Never commit real keys.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for server code (Project settings > Database >
# Connection string, transaction pooler). Bypasses row-level security.
DATABASE_URL=

# Stripe (use test-mode keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_SEMESTER=

# Claude API
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_DRAFT_MODEL=claude-sonnet-5-5
# CLAUDE_CHECK_MODEL=claude-opus-5-5

# Trigger.dev
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
